{
	"name": "sveltelab",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"build": "pnpm run partytown && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dependency-report": "npx --yes license-report@latest --output=json > ./src/lib/dependency-report.json",
		"dev": "concurrently --names sk,pb --prefix-colors auto \"pnpm dev:sk\" \"pnpm dev:pb\"",
		"dev:sk": "vite dev",
		"dev:pb": "./pocketbase serve",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"partytown": "partytown copylib static/~partytown",
		"pocketbase": "./pocketbase serve",
		"preview": "vite preview",
		"skip-build": "node ./skip-build/index.js",
		"test": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@builder.io/partytown": "catalog:",
		"@codemirror/autocomplete": "catalog:",
		"@codemirror/commands": "catalog:",
		"@codemirror/lang-css": "catalog:",
		"@codemirror/lang-html": "catalog:",
		"@codemirror/lang-javascript": "catalog:",
		"@codemirror/lang-json": "catalog:",
		"@codemirror/lang-markdown": "catalog:",
		"@codemirror/language": "catalog:",
		"@codemirror/lint": "catalog:",
		"@codemirror/search": "catalog:",
		"@codemirror/state": "catalog:",
		"@codemirror/view": "catalog:",
		"@emmetio/codemirror6-plugin": "catalog:",
		"@floating-ui/dom": "catalog:",
		"@jridgewell/trace-mapping": "catalog:",
		"@lezer/common": "catalog:",
		"@lezer/highlight": "catalog:",
		"@lezer/javascript": "catalog:",
		"@lezer/lr": "catalog:",
		"@neocodemirror/svelte": "catalog:",
		"@replit/codemirror-lang-svelte": "catalog:",
		"@replit/codemirror-vim": "catalog:",
		"@sveltejs/site-kit": "^3.4.0",
		"@webcontainer/api": "catalog:",
		"@xterm/addon-fit": "catalog:",
		"@xterm/xterm": "catalog:",
		"@yaireo/relative-time": "catalog:",
		"as-comps": "catalog:",
		"flexsearch": "catalog:",
		"fzf": "catalog:",
		"he": "catalog:",
		"jszip": "catalog:",
		"lz-string": "catalog:",
		"magic-string": "catalog:",
		"material-icon-theme": "catalog:",
		"pocketbase": "catalog:",
		"satori": "catalog:",
		"satori-html": "catalog:",
		"semver": "catalog:",
		"svelte-splitpanes": "catalog:",
		"tinykeys": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify/json": "catalog:",
		"@playwright/test": "catalog:",
		"@resvg/resvg-js": "catalog:",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/he": "catalog:",
		"@types/node": "catalog:",
		"@types/semver": "catalog:",
		"@typescript-eslint/eslint-plugin": "catalog:",
		"@typescript-eslint/parser": "catalog:",
		"@zerodevx/svelte-toast": "catalog:",
		"concurrently": "^9.2.1",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "^17.13.0",
		"marked": "catalog:",
		"postcss": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"rollup-plugin-visualizer": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-local-storage-store": "catalog:",
		"svelte-preprocess": "catalog:",
		"sveltekit-search-params": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.71.0",
		"unplugin-icons": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"workbox-precaching": "catalog:"
	},
	"engines": {
		"runtime": {
			"name": "node",
			"version": "^22.0.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.0.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
